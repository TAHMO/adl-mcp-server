# adl-mcp-server — read-only connection to the ADL TimescaleDB
# Copy to .env (gitignored) and fill in the password. The server reads these from its
# environment (see DEPLOY.md), not from this file directly.

ADL_DB_HOST=127.0.0.1
ADL_DB_PORT=5432
ADL_DB_NAME=adl
ADL_DB_USER=adl_readonly
ADL_DB_PASSWORD=change-me
# Or, for docker secrets, point at a file instead of inlining the password:
#ADL_DB_PASSWORD_FILE=/run/secrets/adl_db_password

# Query guards
ADL_DEFAULT_LIMIT=1000
ADL_MAX_LIMIT=50000
ADL_STMT_TIMEOUT_MS=30000
ADL_CONNECT_TIMEOUT_S=10

# Convenience-tool wiring — defaults are GROUNDED in ADL's real data model
# (ADL Core Models Reference + adl/src/adl/core/models.py) and work out-of-the-box
# on a standard ADL deploy. Only set these if a deployment customises db_table.
#ADL_OBS_TABLE=core_observationrecord
#ADL_OBS_TIME_COL=time
#ADL_OBS_VALUE_COL=value
#ADL_OBS_STATION_FK=station_id        # integer FK -> core_station.id
#ADL_OBS_PARAM_FK=parameter_id        # integer FK -> core_dataparameter.id
#ADL_STATION_TABLE=core_station
#ADL_STATION_PK=id
#ADL_STATION_CODE_COL=station_id      # human-readable station code (CharField)
#ADL_STATION_NAME_COL=name
#ADL_PARAM_TABLE=core_dataparameter
#ADL_PARAM_PK=id
#ADL_PARAM_NAME_COL=name
